[net]
git-fetch-with-cli = true

# Local-dev patch: redirect the sem-os git dep to the sibling repo on disk
# so you can edit sem-os source and have dsl pick it up without a tag bump.
#
# Usage: cp .cargo/config.toml.example .cargo/config.toml  (gitignore keeps it local)
# Revert: delete .cargo/config.toml to test against real GitHub tags.
[patch."https://github.com/adamtc007/sem-os"]
sem_os_types    = { path = "../sem-os/crates/sem_os_types"    }
sem_os_core     = { path = "../sem-os/crates/sem_os_core"     }
sem_os_ontology = { path = "../sem-os/crates/sem_os_ontology" }
sem_os_policy   = { path = "../sem-os/crates/sem_os_policy"   }
